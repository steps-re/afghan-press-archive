# Copy to .env and fill in. Nothing here has a default that points at anyone's infrastructure —
# an unset value disables the feature that needs it rather than failing later with a confusing
# 404 from a project you do not own.

HTR_PROJECT=            # GCP project that serves the models, e.g. my-research-project
HTR_LOCATION=us-central1
HTR_BUCKET=             # where artefacts are read and written, e.g. gs://my-bucket
HTR_CONTACT=            # contact address sent in the User-Agent when fetching from libraries

# Optional — only if you have tuned your own reader
HTR_TUNED_ENDPOINT=     # projects/NUMBER/locations/REGION/endpoints/ID

# Optional — only for the cross-vendor comparison arm
HTR_AZURE_ENDPOINT=     # https://your-resource.openai.azure.com
AOAI_KEY=               # never commit this
